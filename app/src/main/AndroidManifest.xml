<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- открыть «Часы» по тапу на часы (обычное разрешение, выдаётся автоматически) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- «Поверх других приложений»: снимает запрет фонового запуска — обои могут открывать Часы и Календарь -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- обновление поверх установленной версии из релиза GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Всплывающий конвертер: открывается тапом по блоку курсов на обоях
             или иконкой «Конвертер» в списке приложений -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <!-- страж касаний: в момент тапа по обоям проверяет, не лежит ли под пальцем иконка или меню лаунчера -->
        <service
            android:name=".TapGuardService"
            android:exported="false"
            android:label="@string/guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tapguard" />
        </service>

        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:label="Цели"
            android:taskAffinity="com.kayo.infowall.goals"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MathEditActivity"
            android:exported="false"
            android:label="Формула"
            android:taskAffinity="com.kayo.infowall.math"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ConverterActivity"
            android:exported="true"
            android:label="@string/converter_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="com.kayo.infowall.converter"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".InfoWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- экран блокировки: только летящий рельеф, без виджетов, ракурс экстремальнее -->
        <service
            android:name=".InfoLockWallpaperService"
            android:exported="true"
            android:label="@string/lock_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_lock" />
        </service>
    </application>
</manifest>
