<!-- Страж касаний: замечает нажатия лаунчера и смену окон (только время и тип) и смотрит, что лежит под точкой тапа по обоям; ничего не нажимает -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
